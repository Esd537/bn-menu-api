# BN MENU - Variaveis de Ambiente
# Copie este arquivo para .env e configure

# Porta do servidor
PORT=3000

# URL publica da API
API_URL=https://bn-menu-api.onrender.com

# Banco persistente (Render Postgres)
# Quando DATABASE_URL estiver preenchida, a API usa Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Ative somente se seu provedor exigir SSL na conexao do Postgres
DATABASE_SSL=false

# Segredos do portal
AUTH_SECRET=troque-este-segredo-do-portal
ADMIN_USERNAME=eabn8
ADMIN_EMAIL=eabn8@bnmenu.local
ADMIN_PASSWORD=admchora

# Chave secreta para autenticacao (opcional)
API_SECRET_KEY=sua-chave-secreta-aqui

# Discord Webhook (opcional - para logs)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/seu-webhook

# Modo de desenvolvimento
NODE_ENV=production
